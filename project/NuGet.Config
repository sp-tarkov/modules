<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Required by central package management to disambiguate the two feeds (silences NU1507).
    BepInEx-prefixed packages come from the BepInEx feed and everything else from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="BepInEx">
      <package pattern="BepInEx.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
