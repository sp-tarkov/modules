<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\SPT.Common\SPT.Common.csproj" />
    <ProjectReference Include="..\SPT.Core\SPT.Core.csproj" />
    <ProjectReference Include="..\SPT.Reflection\SPT.Reflection.csproj" />
    <ProjectReference Include="..\SPT.PrePatch\SPT.PrePatch.csproj" />
    <ProjectReference Include="..\SPT.Debugging\SPT.Debugging.csproj" />
    <ProjectReference Include="..\SPT.SinglePlayer\SPT.SinglePlayer.csproj" />
    <ProjectReference Include="..\SPT.Custom\SPT.Custom.csproj" />
  </ItemGroup>
  <!-- Assembles the deployment structure under project/Build after the aggregator builds. -->
  <Target Name="AssembleBuildOutput" AfterTargets="Build">
    <PropertyGroup>
      <BuildRoot>$(MSBuildProjectDirectory)\..\Build</BuildRoot>
      <PluginsDir>$(BuildRoot)\BepInEx\plugins\spt</PluginsDir>
      <PatchersDir>$(BuildRoot)\BepInEx\patchers</PatchersDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- The preloader patcher deploys to patchers/, every other spt-*.dll to plugins/spt/. -->
      <PatcherDll Include="$(TargetDir)spt-prepatch.dll" />
      <PluginDll Include="$(TargetDir)spt-*.dll" Exclude="@(PatcherDll)" />
    </ItemGroup>
    <!-- Start from a clean tree so removed plugins don't linger. -->
    <RemoveDir Directories="$(BuildRoot)" />
    <Copy SourceFiles="@(PluginDll)" DestinationFolder="$(PluginsDir)" />
    <Copy SourceFiles="@(PatcherDll)" DestinationFolder="$(PatchersDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\LICENSE.md" DestinationFiles="$(BuildRoot)\LICENSE-Modules.txt" />
  </Target>
</Project>
